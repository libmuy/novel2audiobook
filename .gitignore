# Git ignore rules
__pycache__/
*.pyc
*.pyo

# Audio build caches and outputs
chapters/*/audio_cache/*.wav
chapters/*/output/*.mp3
chapters/*/output/*.wav
chapters/*/output/*.srt
.venv/

# IndexTTS-2.5 独立推理环境：官方源码仓库（自行 git clone，见 docs/indextts_setup.md）
# 与 ROCm venv，均为本机专属大体积产物，不随代码分发
tools/indextts_repo/
tools/indextts_env/

# ACE-Step 1.5 独立推理环境：同上，见 docs/audiogen_setup.md
tools/acestep_repo/
tools/acestep_env/

# ACE-Step 运行时自校准缓存（扩散步数耗时估算），机器相关，不随代码分发
.cache/acestep/

# 常驻 TTS 服务的 pidfile/socket，以及 GPU 换手耗时历史：都是本机运行时状态，
# 不随代码分发
.cache/tts_daemon/
.cache/gpu_arbiter/

# TangoFlux 独立推理环境：见 docs/audiogen_setup.md
tools/tangoflux_env/
